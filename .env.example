# Copy this file to .env and fill in the four values.
#Leaving them empty is not possible, docker then refuses to start.

# Password of the database. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=

# Password of the app role notes_app: the app logs in with it, not as the owner. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_DB_PASSWORD=

# Key with which Flask signs session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Key of 256 bits with which the app encrypts the TOTP secret and the notes. Separate from
# FLASK_SECRET_KEY. Whoever loses or replaces it loses all notes and has to set up two-step
# verification again. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
DATA_ENCRYPTION_KEY=
