# Copy this file to .env and fill in the four values, or let
# python scripts/deployment.py local do that.
#Leaving them empty is not possible, docker then refuses to start.

# Password of the database. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=

# Password of the app role notes_app: the app logs in with it, not as the owner. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_DB_PASSWORD=

# Key with which Flask signs session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Key of 256 bits with which the app encrypts the TOTP secret and the notes. Separate from
# FLASK_SECRET_KEY. Whoever loses or replaces it loses all notes and has to set up two-step
# verification again. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
DATA_ENCRYPTION_KEY=

# Optional, only during the hacking week: many users behind one school address.
# THROTTLE_IP_MODE=hackweek: 100 wrong passwords per address per 15 minutes (otherwise 20),
#   and then 5 minutes locked without doubling. An unknown value stops the app from starting.
# THROTTLE_PAIR_EXEMPT_USERS=hackingweek: no counter per name per address for the demo account,
#   so one classmate does not lock it for everyone. The limit per address and the one on the
#   code still apply.
# THROTTLE_IP_MODE=strict
# THROTTLE_PAIR_EXEMPT_USERS=
